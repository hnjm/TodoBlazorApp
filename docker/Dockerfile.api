# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy solution and project files
COPY ["TodoBlazorApp.sln", "./"]
COPY ["src/Core/TodoBlazorApp.Domain/TodoBlazorApp.Domain.csproj", "src/Core/TodoBlazorApp.Domain/"]
COPY ["src/Core/TodoBlazorApp.Application/TodoBlazorApp.Application.csproj", "src/Core/TodoBlazorApp.Application/"]
COPY ["src/Infrastructure/TodoBlazorApp.Infrastructure/TodoBlazorApp.Infrastructure.csproj", "src/Infrastructure/TodoBlazorApp.Infrastructure/"]
COPY ["src/Presentation/TodoBlazorApp.API/TodoBlazorApp.API.csproj", "src/Presentation/TodoBlazorApp.API/"]

# Restore dependencies
RUN dotnet restore "src/Presentation/TodoBlazorApp.API/TodoBlazorApp.API.csproj"

# Copy all source files
COPY . .

# Build the project
WORKDIR "/src/src/Presentation/TodoBlazorApp.API"
RUN dotnet build "TodoBlazorApp.API.csproj" -c Release -o /app/build

# Stage 2: Publish
FROM build AS publish
RUN dotnet publish "TodoBlazorApp.API.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Stage 3: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app

# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Create directory for database
RUN mkdir -p /app/data

# Copy published files
COPY --from=publish /app/publish .

# Set environment variables
ENV ASPNETCORE_URLS=http://+:80
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ConnectionStrings__DefaultConnection="Data Source=/app/data/todoapp.db"

# Expose ports
EXPOSE 80
EXPOSE 443

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost/api/health || exit 1

# Set entry point
ENTRYPOINT ["dotnet", "TodoBlazorApp.API.dll"]