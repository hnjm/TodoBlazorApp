@page "/"

<PageTitle>الرئيسية - نظام إدارة المهام</PageTitle>

<div class="container mt-5" dir="rtl">
    <div class="text-center mb-5">
        <h1 class="display-3 fw-bold text-primary">
            <i class="bi bi-clipboard-check"></i> نظام إدارة المهام
        </h1>
        <p class="lead text-muted">
            تطبيق احترافي لإدارة المهام مبني بـ Clean Architecture
        </p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-layers fs-1 text-primary"></i>
                    </div>
                    <h5 class="card-title">Clean Architecture</h5>
                    <p class="card-text text-muted">
                        معمارية نظيفة مع فصل واضح للطبقات والمسؤوليات
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-arrow-left-right fs-1 text-success"></i>
                    </div>
                    <h5 class="card-title">CQRS & MediatR</h5>
                    <p class="card-text text-muted">
                        فصل عمليات القراءة والكتابة باستخدام MediatR
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-database fs-1 text-info"></i>
                    </div>
                    <h5 class="card-title">SQLite & EF Core</h5>
                    <p class="card-text text-muted">
                        قاعدة بيانات خفيفة مع Entity Framework Core
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-cloud-arrow-up fs-1 text-warning"></i>
                    </div>
                    <h5 class="card-title">RESTful API</h5>
                    <p class="card-text text-muted">
                        واجهة برمجية قياسية مع Swagger Documentation
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-lightning-charge fs-1 text-danger"></i>
                    </div>
                    <h5 class="card-title">Blazor Server</h5>
                    <p class="card-text text-muted">
                        واجهة مستخدم تفاعلية وسريعة
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-gear fs-1 text-secondary"></i>
                    </div>
                    <h5 class="card-title">CI/CD Ready</h5>
                    <p class="card-text text-muted">
                        جاهز للنشر مع Jenkins و Azure DevOps
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center">
        <a href="/todos" class="btn btn-primary btn-lg px-5">
            <i class="bi bi-box-arrow-in-left"></i> ابدأ الآن
        </a>
    </div>

    <div class="mt-5 text-center text-muted">
        <p>
            <i class="bi bi-code-slash"></i> 
            طور بواسطة <strong>HNJM</strong> | 
            <a href="https://github.com/hnjm/TodoBlazorApp" target="_blank" class="text-decoration-none">
                <i class="bi bi-github"></i> GitHub
            </a>
        </p>
    </div>
</div>